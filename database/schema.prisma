generator client {
  provider        = "prisma-client-js"
  output          = "@prisma/client"
  previewFeatures = ["relationJoins"]
  engineType      = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Accounts {
  id          Int      @id @default(autoincrement())
  userID      String
  imageFile   String
  textFile    String?
  timeCreated DateTime
}
